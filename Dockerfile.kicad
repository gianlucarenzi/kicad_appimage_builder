# Dockerfile per creare l'AppImage di KiCad 5.1
FROM ubuntu:20.04

# Evita richieste interattive
ARG DEBIAN_FRONTEND=noninteractive

# Architettura dell'AppImage (x86_64, aarch64, armhf) e triplet multiarch Debian
# corrispondente (x86_64-linux-gnu, aarch64-linux-gnu, arm-linux-gnueabihf):
# li passa build_kicad_appimage.sh insieme a --platform
ARG APPIMAGE_ARCH=x86_64
ARG MULTIARCH=x86_64-linux-gnu
ENV APPIMAGE_ARCH=$APPIMAGE_ARCH
ENV MULTIARCH=$MULTIARCH

# Installa dipendenze base
RUN apt-get update && apt-get install -y \
    software-properties-common \
    ca-certificates \
    curl \
    dirmngr \
    libgl1-mesa-glx \
    librsvg2-bin \
    libgdk-pixbuf2.0-bin \
    dpkg-dev \
    pkg-config \
    python3-dev \
    libatk-bridge2.0-0 \
    libcanberra-gtk3-module \
    && rm -rf /var/lib/apt/lists/* && \
    test "$(dpkg-architecture -qDEB_HOST_MULTIARCH)" = "$MULTIARCH"

# Aggiunge PPA KiCad
RUN apt-key adv --keyserver keyserver.ubuntu.com --recv-keys FDA854F61C4D0D9572BB95E5245D5502FAD7A805 && \
    add-apt-repository --yes ppa:kicad/kicad-5.1-releases

# Installa KiCad e librerie
RUN apt-get update && apt-get install -y \
    kicad \
    kicad-libraries \
    kicad-symbols \
    kicad-footprints \
    kicad-packages3d \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Estrae un AppImage in squashfs-root/ della directory corrente. Emulato da QEMU
# (binfmt_misc) un AppImage non parte ("Exec format error"): QEMU vuole zeri nei
# byte 8-10 dell'header ELF, dove l'AppImage ha il magic AI\x02. Una copia senza
# quei byte esegue lo stesso runtime (che non li legge); nativamente non cambia nulla.
RUN printf '%s\n' '#!/bin/sh' 'set -e' \
    'cp "$1" /tmp/appimage.run' \
    "printf '\\0\\0\\0' | dd of=/tmp/appimage.run bs=1 seek=8 count=3 conv=notrunc 2>/dev/null" \
    'chmod +x /tmp/appimage.run' \
    '/tmp/appimage.run --appimage-extract >/dev/null' \
    'rm -f /tmp/appimage.run' > /usr/local/bin/appimage-extract && \
    chmod +x /usr/local/bin/appimage-extract

# Prepara linuxdeploy
# curl e non wget: sotto QEMU armhf wget non riesce a verificare il certificato di github.com
RUN curl -fsSLO https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-$APPIMAGE_ARCH.AppImage && \
    appimage-extract linuxdeploy-$APPIMAGE_ARCH.AppImage

ENV APP=KiCad
ENV VERSION=5.1.12

# Crea struttura AppDir
RUN mkdir -p $APP.AppDir/usr/bin \
    $APP.AppDir/usr/lib/$MULTIARCH/kicad \
    $APP.AppDir/usr/share

# Copia binari e risorse
RUN cp /usr/bin/kicad* $APP.AppDir/usr/bin/ && \
    cp /usr/bin/_* $APP.AppDir/usr/bin/ && \
    cp /usr/bin/eeschema $APP.AppDir/usr/bin/ && \
    cp /usr/bin/gerbview $APP.AppDir/usr/bin/ && \
    cp /usr/bin/pcbnew $APP.AppDir/usr/bin/ && \
    cp /usr/bin/pl_editor $APP.AppDir/usr/bin/ && \
    cp /usr/bin/bitmap2component $APP.AppDir/usr/bin/ && \
    cp /usr/bin/pcb_calculator $APP.AppDir/usr/bin/ && \
    cp -r /usr/lib/$MULTIARCH/kicad/plugins $APP.AppDir/usr/lib/$MULTIARCH/kicad/ && \
    cp -r /usr/share/kicad $APP.AppDir/usr/share/

# Python
RUN cp /usr/bin/python3* $APP.AppDir/usr/bin/ && \
    mkdir -p $APP.AppDir/usr/lib/python3.8 && \
    cp -r /usr/lib/python3.8/* $APP.AppDir/usr/lib/python3.8/ && \
    mkdir -p $APP.AppDir/usr/lib/python3/dist-packages && \
    cp -r /usr/lib/python3/dist-packages/* $APP.AppDir/usr/lib/python3/dist-packages/

# Supporto Grafico, Icone e GIO (CRITICO)
RUN cp /usr/lib/$MULTIARCH/gdk-pixbuf-2.0/gdk-pixbuf-query-loaders $APP.AppDir/usr/bin/ && \
    mkdir -p $APP.AppDir/usr/lib/$MULTIARCH/gdk-pixbuf-2.0/2.10.0/loaders && \
    cp /usr/lib/$MULTIARCH/gdk-pixbuf-2.0/2.10.0/loaders/*.so $APP.AppDir/usr/lib/$MULTIARCH/gdk-pixbuf-2.0/2.10.0/loaders/ && \
    mkdir -p $APP.AppDir/usr/lib/$MULTIARCH/gio/modules && \
    cp /usr/lib/$MULTIARCH/gio/modules/*.so $APP.AppDir/usr/lib/$MULTIARCH/gio/modules/ && \
    mkdir -p $APP.AppDir/usr/share/icons && \
    cp -r /usr/share/icons/hicolor $APP.AppDir/usr/share/icons/ && \
    mkdir -p $APP.AppDir/usr/share/mime && \
    cp -r /usr/share/mime/* $APP.AppDir/usr/share/mime/

# Esegue linuxdeploy per dipendenze librerie
RUN squashfs-root/AppRun --appdir $APP.AppDir \
    --executable /usr/bin/kicad \
    --desktop-file /usr/share/applications/kicad.desktop \
    --icon-file /usr/share/icons/hicolor/128x128/apps/kicad.png || true

# Rinomina binario per wrapper
RUN mv $APP.AppDir/usr/bin/kicad $APP.AppDir/usr/bin/kicad.bin && \
    rm -f $APP.AppDir/AppRun $APP.AppDir/AppRun.original

# Crea AppRun finale isolato
RUN echo '#!/bin/bash' > $APP.AppDir/AppRun && \
    echo 'HERE=$(dirname "$(readlink -f "${0}")")' >> $APP.AppDir/AppRun && \
    echo 'export APPDIR="$HERE"' >> $APP.AppDir/AppRun && \
    echo '' >> $APP.AppDir/AppRun && \
    echo '# Isolamento Librerie' >> $APP.AppDir/AppRun && \
    echo 'export LD_LIBRARY_PATH="${HERE}/usr/lib:${HERE}/usr/lib/'"$MULTIARCH"':${LD_LIBRARY_PATH}"' >> $APP.AppDir/AppRun && \
    echo 'export PATH="${HERE}/usr/bin:${PATH}"' >> $APP.AppDir/AppRun && \
    echo 'export XDG_DATA_DIRS="${HERE}/usr/share:${XDG_DATA_DIRS}"' >> $APP.AppDir/AppRun && \
    echo '' >> $APP.AppDir/AppRun && \
    echo '# Python' >> $APP.AppDir/AppRun && \
    echo 'export PYTHONHOME="${HERE}/usr"' >> $APP.AppDir/AppRun && \
    echo 'export PYTHONPATH="${HERE}/usr/lib/python3.8:${HERE}/usr/lib/python3/dist-packages"' >> $APP.AppDir/AppRun && \
    echo '' >> $APP.AppDir/AppRun && \
    echo '# KiCad Paths' >> $APP.AppDir/AppRun && \
    echo 'export KICAD_PATH="${HERE}/usr/share/kicad"' >> $APP.AppDir/AppRun && \
    echo 'export KICAD_TEMPLATE_DIR="${KICAD_PATH}/template"' >> $APP.AppDir/AppRun && \
    echo 'export KICAD_SYMBOL_DIR="${KICAD_PATH}/library"' >> $APP.AppDir/AppRun && \
    echo 'export KISYSMOD="${KICAD_PATH}/modules"' >> $APP.AppDir/AppRun && \
    echo 'export KISYS3DMOD="${KISYSMOD}/packages3d"' >> $APP.AppDir/AppRun && \
    echo '' >> $APP.AppDir/AppRun && \
    echo '# Plugin 3D: KiCad 5 li cerca solo in /usr/lib/'"$MULTIARCH"'/kicad/plugins/3d (percorso' >> $APP.AppDir/AppRun && \
    echo '# fisso di compilazione) o in ~/.kicad/plugins/3d: senza, il 3D non mostra alcun modello' >> $APP.AppDir/AppRun && \
    echo 'KICAD_3D_PLUGINS="${HOME}/.kicad/plugins/3d"' >> $APP.AppDir/AppRun && \
    echo 'mkdir -p "$KICAD_3D_PLUGINS"' >> $APP.AppDir/AppRun && \
    echo 'for p in "${HERE}/usr/lib/'"$MULTIARCH"'/kicad/plugins/3d"/*.so; do' >> $APP.AppDir/AppRun && \
    echo '  cmp -s "$p" "$KICAD_3D_PLUGINS/$(basename "$p")" || cp -f "$p" "$KICAD_3D_PLUGINS/"' >> $APP.AppDir/AppRun && \
    echo 'done' >> $APP.AppDir/AppRun && \
    echo '' >> $APP.AppDir/AppRun && \
    echo '# GIO/GVFS Isolation (Fix undefined symbols)' >> $APP.AppDir/AppRun && \
    echo 'export GIO_MODULE_DIR="${HERE}/usr/lib/'"$MULTIARCH"'/gio/modules"' >> $APP.AppDir/AppRun && \
    echo 'unset GIO_EXTRA_MODULES' >> $APP.AppDir/AppRun && \
    echo '' >> $APP.AppDir/AppRun && \
    echo '# Visual Stability' >> $APP.AppDir/AppRun && \
    echo 'export GTK_THEME="Adwaita"' >> $APP.AppDir/AppRun && \
    echo 'export GDK_PIXBUF_MODULEDIR="${HERE}/usr/lib/'"$MULTIARCH"'/gdk-pixbuf-2.0/2.10.0/loaders"' >> $APP.AppDir/AppRun && \
    echo 'export GDK_PIXBUF_MODULE_FILE="/tmp/kicad-gdk-pixbuf-$$.cache"' >> $APP.AppDir/AppRun && \
    echo 'if [ -x "${HERE}/usr/bin/gdk-pixbuf-query-loaders" ]; then' >> $APP.AppDir/AppRun && \
    echo '  "${HERE}/usr/bin/gdk-pixbuf-query-loaders" "${GDK_PIXBUF_MODULEDIR}"/*.so > "$GDK_PIXBUF_MODULE_FILE"' >> $APP.AppDir/AppRun && \
    echo 'fi' >> $APP.AppDir/AppRun && \
    echo 'trap '\''rm -f "$GDK_PIXBUF_MODULE_FILE"'\'' EXIT' >> $APP.AppDir/AppRun && \
    echo '' >> $APP.AppDir/AppRun && \
    echo 'exec "${HERE}/usr/bin/kicad.bin" "$@"' >> $APP.AppDir/AppRun && \
    chmod +x $APP.AppDir/AppRun

# Genera AppImage (appimagetool dell'architettura: include il runtime giusto).
# appimagetool riconosce in ARCH solo x86_64, arm e arm_aarch64: con un altro nome
# prova a dedurre l'architettura dalle librerie e su aarch64 fallisce
RUN curl -fsSLO https://github.com/AppImage/AppImageKit/releases/download/continuous/appimagetool-$APPIMAGE_ARCH.AppImage && \
    mkdir appimagetool && cd appimagetool && appimage-extract ../appimagetool-$APPIMAGE_ARCH.AppImage && cd .. && \
    case $APPIMAGE_ARCH in aarch64) TOOL_ARCH=arm_aarch64 ;; armhf) TOOL_ARCH=arm ;; *) TOOL_ARCH=$APPIMAGE_ARCH ;; esac && \
    ARCH=$TOOL_ARCH appimagetool/squashfs-root/AppRun --no-appstream $APP.AppDir $APP-$VERSION-$APPIMAGE_ARCH.AppImage
